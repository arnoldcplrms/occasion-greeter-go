# Couples data as JSON string (copy the contents of couples.json)
# COUPLES_DATA='[{...}]'

# CSV source URL (e.g. an exported Google Sheet). Used when set.
CSV_URL=https://docs.google.com/spreadsheets/d/<FILE_ID>/export?format=csv

# Occasion photo manifest URL (JSON file mapping celebrant keys to image URLs)
OCCASION_PHOTO_MANIFEST_URL=https://drive.google.com/file/d/<MANIFEST_FILE_ID>/view?usp=sharing

# Comma-separated recipient list
RECIPIENT_EMAIL=you@example.com

# SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
